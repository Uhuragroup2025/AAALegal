# Secretos y configuración sensible
.env
.env.*
!.env.example
wp-config.php
*.pem
*.key
secrets/
credentials/

# Base de datos
*.sql
*.sqlite
*.sqlite3
/db-backup/
/database/

# WordPress core y plugins — no se versionan en este repo (D99, 2026-09-07):
# solo se versiona el tema propio, wp-content/themes/aaa-estudio-legal/.
# Núcleo y plugins se instalan vía WP admin siguiendo WORDPRESS-SETUP.md.
/wp-admin/
/wp-includes/
/wp-*.php
wp-content/plugins/
wp-content/themes/*/
!wp-content/themes/aaa-estudio-legal/

# Uploads (contenido subido por el CMS, no versionado)
wp-content/uploads/

# Cachés
wp-content/cache/
wp-content/cache-*/
.cache/
*.cache

# Logs
*.log
logs/
debug.log
wp-content/debug.log

# Temporales / SO / editor
*.tmp
*.temp
~*
Thumbs.db
.DS_Store
*.swp

# Dependencias generadas
node_modules/
vendor/

# Configuración local de Claude Code (permisos específicos de esta máquina)
.claude/settings.local.json
