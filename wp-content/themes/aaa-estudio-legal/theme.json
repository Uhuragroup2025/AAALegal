{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "_comment": "Traducido 1:1 de prototype/css/tokens.css (Decisión D26 — paleta; D30 — tipografía; D99 — 03A cierra este mapeo). Cada slug de aquí espeja el nombre del token CSS original, quitando el prefijo --color-/--text-/--space-, para que el historial de decisiones (PROJECT.md) siga siendo la fuente de verdad de por qué cada valor es el que es. No se traducen aquí los valores puramente decorativos que dependen de composición por componente (halos, glass, sombras de hover) — esos viven en patterns/estilos de bloque, no en theme.json.",

  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "navy-deep", "name": "Navy deep (Primary)", "color": "#063B59" },
        { "slug": "navy-hover", "name": "Navy hover (Primary-deep)", "color": "#032C43" },
        { "slug": "navy-elevated", "name": "Navy elevated", "color": "#084D74" },
        { "slug": "accent-main", "name": "Cobre (Accent)", "color": "#CAA181" },
        { "slug": "accent-main-strong", "name": "Cobre AA (Accent-deep)", "color": "#9A6D4D" },
        { "slug": "accent-light", "name": "Azul claro (Secondary)", "color": "#B9CEED" },
        { "slug": "surface-light", "name": "Marfil (Background)", "color": "#F5F3EE" },
        { "slug": "surface-muted", "name": "Marfil suave (cards/citas)", "color": "#E6E4DC" },
        { "slug": "ink-dark", "name": "Tinta (Text)", "color": "#111820" },
        { "slug": "text-muted", "name": "Texto secundario", "color": "#5E666D" },
        { "slug": "border-flat", "name": "Borde sólido", "color": "#D9D9D9" },
        { "slug": "white", "name": "Blanco (Surface)", "color": "#FFFFFF" }
      ],
      "gradients": [
        {
          "slug": "cierre-card",
          "name": "Cierre — tarjeta navy (D74)",
          "gradient": "linear-gradient(138deg, var(--wp--preset--color--navy-deep) 0%, var(--wp--preset--color--navy-hover) 100%)"
        },
        {
          "slug": "footer",
          "name": "Footer",
          "gradient": "linear-gradient(138deg, var(--wp--preset--color--navy-deep) 0%, var(--wp--preset--color--navy-hover) 100%)"
        }
      ]
    },

    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (títulos)",
          "fontFamily": "'Libre Caslon Display', Georgia, 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Libre Caslon Display",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/libre-caslon-display-400.woff2"]
            }
          ]
        },
        {
          "slug": "display-italic",
          "name": "Display itálica (énfasis, .text-gradient)",
          "fontFamily": "'Libre Caslon Text', Georgia, 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Libre Caslon Text",
              "fontWeight": "400",
              "fontStyle": "italic",
              "src": ["file:./assets/fonts/libre-caslon-text-400-italic.woff2"]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Sans (cuerpo, Krub)",
          "fontFamily": "'Krub', 'Segoe UI', system-ui, -apple-system, sans-serif",
          "fontFace": [
            { "fontFamily": "Krub", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/krub-400.woff2"] },
            { "fontFamily": "Krub", "fontWeight": "500", "fontStyle": "normal", "src": ["file:./assets/fonts/krub-500.woff2"] },
            { "fontFamily": "Krub", "fontWeight": "600", "fontStyle": "normal", "src": ["file:./assets/fonts/krub-600.woff2"] },
            { "fontFamily": "Krub", "fontWeight": "700", "fontStyle": "normal", "src": ["file:./assets/fonts/krub-700.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.8125rem" },
        { "slug": "sm", "name": "SM", "size": "0.9375rem" },
        { "slug": "base", "name": "Base", "size": "1.0625rem" },
        { "slug": "md", "name": "MD", "size": "1.25rem" },
        { "slug": "lg", "name": "LG", "size": "1.75rem" },
        { "slug": "xl", "name": "XL", "size": "2.25rem" },
        { "slug": "2xl", "name": "2XL", "size": "3rem" },
        { "slug": "3xl", "name": "3XL", "size": "3.75rem" }
      ],
      "lineHeight": true
    },

    "spacing": {
      "customSpacingSize": false,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "1", "name": "1 (4px)", "size": "0.25rem" },
        { "slug": "2", "name": "2 (8px)", "size": "0.5rem" },
        { "slug": "3", "name": "3 (12px)", "size": "0.75rem" },
        { "slug": "4", "name": "4 (16px)", "size": "1rem" },
        { "slug": "6", "name": "6 (24px)", "size": "1.5rem" },
        { "slug": "8", "name": "8 (32px)", "size": "2rem" },
        { "slug": "12", "name": "12 (48px)", "size": "3rem" },
        { "slug": "16", "name": "16 (64px)", "size": "4rem" },
        { "slug": "24", "name": "24 (96px)", "size": "6rem" },
        { "slug": "32", "name": "32 (128px)", "size": "8rem" }
      ]
    },

    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },

    "custom": {
      "radius": {
        "sm": "4px",
        "md": "8px",
        "container": "12px",
        "lg": "16px",
        "xl": "24px",
        "pill": "999px"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(6, 59, 89, 0.06)",
        "md": "0 8px 24px rgba(6, 59, 89, 0.10)",
        "lg": "0 24px 48px rgba(6, 59, 89, 0.16)"
      },
      "motion": {
        "fast": "200ms",
        "base": "300ms",
        "slow": "450ms",
        "entrance": "700ms",
        "stagger-step": "90ms",
        "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
        "ease-entrance": "cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  },

  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface-light)",
      "text": "var(--wp--preset--color--ink-dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--navy-deep)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent-main-strong)" } }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "lineHeight": "1.1"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--sans)" }
      }
    }
  },

  "templateParts": [
    { "name": "header", "area": "header", "title": "Header" },
    { "name": "footer", "area": "footer", "title": "Footer" }
  ]
}
